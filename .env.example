# ── MongoDB ──────────────────────────────────────────────────────────────────
# Local (Docker):
MONGO_URI=mongodb://localhost:27017/?directConnection=true
# Atlas Cloud (replace with your connection string):
# MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=legal_knowledge_assistant

# ── OpenAI (optional — system falls back to deterministic reasoning if absent) ─
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=2048

# ── Pipeline paths ────────────────────────────────────────────────────────────
PIPELINE_INPUT=./data/uploads
PIPELINE_OUTPUT=./data/reports

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Admin panel ───────────────────────────────────────────────────────────────
ADMIN_API_KEY=change-me-to-a-strong-secret

# ── Feature flags ─────────────────────────────────────────────────────────────
ENABLE_OCR=true
ENABLE_GRAPH=true
