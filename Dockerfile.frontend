# ── Stage 1: Build React + Vite ─────────────────────────────────────────────
# Build context must be set to the frontend directory:
#   docker build -f Dockerfile.frontend frontend
# Or via docker-compose (see docker-compose.yml frontend service).

FROM node:20-alpine AS builder

WORKDIR /app

COPY package*.json ./
RUN npm ci --prefer-offline 2>/dev/null || npm install

COPY . .

# Build-time API URL (override with --build-arg VITE_API_URL=http://your-api:8000)
ARG VITE_API_URL=http://localhost:8000
ENV VITE_API_URL=$VITE_API_URL

RUN npm run build

# ── Stage 2: Serve with nginx ────────────────────────────────────────────────
FROM nginx:1.27-alpine AS runtime

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 3000

CMD ["nginx", "-g", "daemon off;"]
